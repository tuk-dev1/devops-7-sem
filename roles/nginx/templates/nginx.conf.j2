events {
    worker_connections  {{ nginx_worker_connections | default(1024) }};  ## Default: 1024
}

http {
    server {
        listen {{ nginx_port | default(80) }};
        server_name {{ nginx_server_name | default(ansible_hostname) }};

        location / {
            proxy_pass http://{{ django_host | default('127.0.0.1') }}:{{ django_port | default(8000) }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /static/ {
            alias {{ django_static_dir | default('/tmp/django_app/static') }};
        }
    }
}